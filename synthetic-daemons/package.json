{
  "name": "synthetic-daemons",
  "version": "1.0.0",
  "description": "HTTP mock servers emulating Elemento client daemons for Electros UI development",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prestart": "tsc",
    "generate:paas-fixtures": "node scripts/generate-paas-fixtures.mjs",
    "generate:iaas-fixtures": "node scripts/generate-iaas-fixtures.mjs",
    "generate:targets-fixtures": "node scripts/generate-targets-fixtures.mjs",
    "generate:licenses-fixtures": "node scripts/generate-licenses-fixtures.mjs",
    "generate:fixtures": "npm run generate:targets-fixtures && npm run generate:iaas-fixtures && npm run generate:paas-fixtures && npm run generate:licenses-fixtures"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
